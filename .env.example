# Copy to .env (never committed) and fill in.
# Supabase dashboard -> floor-staging -> Connect -> Session pooler (use the service/postgres user).
DATABASE_URL=
# Free key from https://api.data.gov/signup (used for Congress.gov bill data).
CONGRESS_API_KEY=
# Optional, the Local tab (v0.2.60). Open States v3 key (https://open.pluralpolicy.com/accounts/profile/):
# the worker's state bills, and the API's /v1/local/{state}/legislators (set it on floor-api too).
OPENSTATES_API_KEY=
# Optional: NYC Council's Legistar token (request it from the Council; without it NYC skips).
NYC_LEGISTAR_TOKEN=
