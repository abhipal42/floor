{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/bill/:path*", "destination": "https://floor-api.vercel.app/bill/:path*" },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "https://floor-api.vercel.app/.well-known/apple-app-site-association"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "https://floor-api.vercel.app/.well-known/assetlinks.json"
    }
  ]
}
