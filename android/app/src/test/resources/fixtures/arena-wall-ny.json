  },
  {
   "id": "bluesky:at://did:plc:e7atmcvv2bblzo6biapuzi35/app.bsky.feed.post/3n2bqem6zfc27",
   "memberId": "G000555",
   "network": "bluesky",
   "postedAt": "2026-11-14T14:44:31.598Z",
   "text": "The VA has never conducted large-scale research into the full impact of military toxic exposure on women\u2019s health \u2014 including infertility, birth defects, and developmental disabilities.\n\nThey deserve answers, and I\u2019m fighting to make sure they get them.",
   "url": "https://bsky.app/profile/kirstengillibrand.bsky.social/post/3n2bqem6zfc27",
   "mediaUrl": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:e7atmcvv2bblzo6biapuzi35/bafkreieuzfgwfzikhfxh7ya4uh3twqmuvk3v7wc4tuaimbfsnbrxq2saou"
  },
  {
