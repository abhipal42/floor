   "memberId": "N000002",
   "network": "bluesky",
   "postedAt": "2026-11-13T20:34:16.700Z",
   "text": "Trump calls Artificial Intelligence \"Super Intelligence\". In reality, a more accurate name would be \"Stolen Intelligence.\"\n\nwww.billboard.com/pro/congress...",
   "url": "https://bsky.app/profile/nadler.house.gov/post/3n27th3oo522m",
