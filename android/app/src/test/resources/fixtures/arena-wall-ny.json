  },
  {
   "id": "bluesky:at://did:plc:e7atmcvv2bblzo6biapuzi35/app.bsky.feed.post/3n2egditmh22q",
   "memberId": "G000555",
   "network": "bluesky",
   "postedAt": "2026-11-15T16:22:56.325Z",
   "text": "I'm committed to making sure our veterans get the care and benefits they've earned.",
   "url": "https://bsky.app/profile/kirstengillibrand.bsky.social/post/3n2egditmh22q",
   "mediaUrl": "https://video.bsky.app/watch/did%3Aplc%3Ae7atmcvv2bblzo6biapuzi35/bafkreifqbp5vxgyjmmmtuqma4dwgawruywg4mnkdiyjeis3g3xj2bfbk3y/thumbnail.jpg"
  },
  {
   "id": "bluesky:at://did:plc:e7atmcvv2bblzo6biapuzi35/app.bsky.feed.post/3n2bzb6bu5s2m",
   "memberId": "G000555",
   "network": "bluesky",
   "postedAt": "2026-11-14T17:23:40.026Z",
   "text": "Our service members, veterans, and military families exemplify true bravery and sacrifice. We owe them a debt of gratitude.",
   "url": "https://bsky.app/profile/kirstengillibrand.bsky.social/post/3n2bzb6bu5s2m",
