   "memberId": "G000555",
   "network": "bluesky",
   "postedAt": "2026-11-16T21:59:16.235Z",
   "text": "Let's build on our blue tsunami and elect more leaders who are focused on making life better for working Americans!",
   "url": "https://bsky.app/profile/kirstengillibrand.bsky.social/post/3n2hjltegqc23",
