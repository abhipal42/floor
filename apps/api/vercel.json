{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "includeFiles": "{assets/**,../../node_modules/harfbuzzjs/hb.wasm,../../node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    }
  }
}
