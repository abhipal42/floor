{
  "openapi": "3.0.0",
  "info": {
    "title": "Floor API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "VoteKind": {
        "type": "string",
        "enum": [
          "question",
          "election"
        ],
        "description": "election = Speaker election (candidate votes)"
      },
      "Chamber": {
        "type": "string",
        "enum": [
          "house",
          "senate"
        ]
      },
      "VoteState": {
        "type": "string",
        "enum": [
          "scheduled",
          "open",
          "final"
        ]
      },
      "VoteThreshold": {
        "type": "string",
        "enum": [
          "majority",
          "three_fifths_sworn",
          "two_thirds"
        ]
      },
      "VoteTotals": {
        "type": "object",
        "properties": {
          "yea": {
            "type": "integer"
          },
          "nay": {
            "type": "integer"
          },
          "present": {
            "type": "integer"
          },
          "notVoting": {
            "type": "integer"
          }
        },
        "required": [
          "yea",
          "nay",
          "present",
          "notVoting"
        ]
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Jeffries"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "total"
        ]
      },
      "PartyTotals": {
        "type": "object",
        "properties": {
          "party": {
            "type": "string",
            "example": "D"
          },
          "yea": {
            "type": "integer"
          },
          "nay": {
            "type": "integer"
          },
          "present": {
            "type": "integer"
          },
          "notVoting": {
            "type": "integer"
          }
        },
        "required": [
          "party",
          "yea",
          "nay",
          "present",
          "notVoting"
        ]
      },
      "CandidateTotal": {
        "type": "object",
        "properties": {
          "party": {
            "type": "string",
            "example": "D"
          },
          "candidate": {
            "type": "string",
            "example": "Jeffries"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "party",
          "candidate",
          "total"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "bioguideId": {
            "type": "string",
            "example": "A000370"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "party": {
            "type": "string",
            "example": "D"
          },
          "state": {
            "type": "string",
            "example": "NC"
          },
          "district": {
            "type": "integer",
            "nullable": true
          },
          "chamber": {
            "$ref": "#/components/schemas/Chamber"
          }
        },
        "required": [
          "bioguideId",
          "firstName",
          "lastName",
          "party",
          "state",
          "district",
          "chamber"
        ]
      },
      "Position": {
        "type": "string",
        "enum": [
          "yea",
          "nay",
          "present",
          "not_voting",
          "candidate"
        ],
        "description": "candidate is only used on Speaker elections"
      },
      "MemberPosition": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "choice": {
            "type": "string",
            "nullable": true,
            "description": "Candidate named in a Speaker election"
          }
        },
        "required": [
          "member",
          "position",
          "choice"
        ]
      },
      "MeasureSummary": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": {
            "type": "string",
            "example": "119-hr-1013"
          },
          "kind": {
            "type": "string",
            "enum": [
              "bill",
              "nomination"
            ]
          },
          "citation": {
            "type": "string",
            "description": "As the chamber cites it",
            "example": "H.R. 1013"
          },
          "title": {
            "type": "string",
            "description": "A bill's short title where it has one, else its full title; a nomination's nominee, or the post for a military nomination that names nobody"
          }
        },
        "required": [
          "id",
          "kind",
          "citation",
          "title"
        ],
        "description": "What was voted on, or null for a procedural vote that refers to no measure"
      },
      "VoteDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "house-119-1-100"
          },
          "kind": {
            "$ref": "#/components/schemas/VoteKind"
          },
          "chamber": {
            "$ref": "#/components/schemas/Chamber"
          },
          "congress": {
            "type": "integer"
          },
          "session": {
            "type": "integer"
          },
          "rollNumber": {
            "type": "integer",
            "nullable": true
          },
          "question": {
            "type": "string"
          },
          "billId": {
            "type": "string",
            "nullable": true
          },
          "nominationId": {
            "type": "string",
            "nullable": true,
            "example": "119-pn-1093-3"
          },
          "billRef": {
            "type": "string",
            "nullable": true,
            "example": "H CON RES 14"
          },
          "occurredAt": {
            "type": "string",
            "nullable": true,
            "example": "2025-04-10T15:08:00.000Z"
          },
          "state": {
            "$ref": "#/components/schemas/VoteState"
          },
          "threshold": {
            "$ref": "#/components/schemas/VoteThreshold"
          },
          "totals": {
            "$ref": "#/components/schemas/VoteTotals"
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "result": {
            "type": "string",
            "nullable": true
          },
          "partyTotals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartyTotals"
            },
            "description": "Per-party counts. An election reports its party split in candidateTotals instead."
          },
          "candidateTotals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandidateTotal"
            },
            "description": "Which candidate each party voted for. Only populated when kind = election."
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberPosition"
            },
            "description": "How the members named in ?members= voted. Empty when the query names none."
          },
          "measure": {
            "$ref": "#/components/schemas/MeasureSummary"
          }
        },
        "required": [
          "id",
          "kind",
          "chamber",
          "congress",
          "session",
          "rollNumber",
          "question",
          "billId",
          "nominationId",
          "billRef",
          "occurredAt",
          "state",
          "threshold",
          "totals",
          "candidates",
          "result",
          "partyTotals",
          "candidateTotals",
          "positions",
          "measure"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PartyLoyalty": {
        "type": "object",
        "properties": {
          "votes": {
            "type": "integer",
            "description": "Yea/nay votes counted: those where the member voted yea or nay and their party was not itself tied"
          },
          "withParty": {
            "type": "integer"
          },
          "againstParty": {
            "type": "integer"
          }
        },
        "required": [
          "votes",
          "withParty",
          "againstParty"
        ]
      },
      "MemberDetail": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "partyLoyalty": {
            "$ref": "#/components/schemas/PartyLoyalty"
          }
        },
        "required": [
          "member",
          "partyLoyalty"
        ]
      },
      "PacCheck": {
        "type": "object",
        "properties": {
          "committeeId": {
            "type": "string",
            "example": "C00002550"
          },
          "name": {
            "type": "string",
            "example": "American Trucking Associations PAC"
          },
          "kind": {
            "type": "string",
            "nullable": true,
            "description": "From FEC's committee type for another candidate's own committee ('Candidate committee'), else its organization type or leadership-PAC designation; null when FEC classifies the committee as nothing",
            "example": "Trade group"
          },
          "orgType": {
            "type": "string",
            "nullable": true,
            "description": "Raw FEC ORG_TP, so a client can classify differently",
            "example": "T"
          },
          "connectedOrg": {
            "type": "string",
            "nullable": true,
            "example": "American Trucking Associations"
          },
          "direct": {
            "type": "number",
            "description": "The committee's own contributions"
          },
          "earmarked": {
            "type": "number",
            "description": "Individuals' money passed through it"
          }
        },
        "required": [
          "committeeId",
          "name",
          "kind",
          "orgType",
          "connectedOrg",
          "direct",
          "earmarked"
        ]
      },
      "Funding": {
        "type": "object",
        "nullable": true,
        "properties": {
          "cycle": {
            "type": "integer",
            "description": "The election this campaign is for",
            "example": 2026
          },
          "coverageStart": {
            "type": "string",
            "nullable": true,
            "example": "2025-01-01"
          },
          "coverageEnd": {
            "type": "string",
            "nullable": true,
            "description": "Through which the figures run",
            "example": "2026-10-14"
          },
          "receipts": {
            "type": "number",
            "description": "Total raised this campaign to date, as the campaign reported it"
          },
          "smallDollar": {
            "type": "number",
            "description": "Individual contributions under $200 per donor (unitemized)"
          },
          "itemized": {
            "type": "number",
            "description": "Individual contributions itemized by FEC"
          },
          "pac": {
            "type": "number",
            "description": "From other political committees"
          },
          "party": {
            "type": "number",
            "description": "From party committees"
          },
          "other": {
            "type": "number",
            "description": "Transfers, the candidate's own money, refunds and other receipts"
          },
          "cashOnHand": {
            "type": "number",
            "nullable": true
          },
          "committeesCycle": {
            "type": "integer",
            "nullable": true,
            "description": "The two-year FEC cycle `committees` covers, which is NOT `cycle`: a senator's campaign may be for 2028 while the committee filings are the 2026 cycle. Null when we hold no committee rows for them.",
            "example": 2026
          },
          "committees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PacCheck"
            },
            "description": "Biggest PAC givers by direct amount. Party and joint fundraising committees are excluded — neither is a PAC check (lesson 23)"
          }
        },
        "required": [
          "cycle",
          "coverageStart",
          "coverageEnd",
          "receipts",
          "smallDollar",
          "itemized",
          "pac",
          "party",
          "other",
          "cashOnHand",
          "committeesCycle",
          "committees"
        ]
      },
      "MemberFunding": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "funding": {
            "$ref": "#/components/schemas/Funding"
          }
        },
        "required": [
          "member",
          "funding"
        ],
        "description": "funding is null for a member FEC has no current-campaign totals for"
      },
      "District": {
        "type": "object",
        "properties": {
          "congress": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "example": "TX"
          },
          "district": {
            "type": "integer"
          },
          "countyFips": {
            "type": "string",
            "nullable": true,
            "example": "48453"
          }
        },
        "required": [
          "congress",
          "state",
          "district",
          "countyFips"
        ]
      },
      "Reps": {
        "type": "object",
        "properties": {
          "district": {
            "$ref": "#/components/schemas/District"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          }
        },
        "required": [
          "district",
          "members"
        ]
      },
      "Vote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "house-119-1-100"
          },
          "kind": {
            "$ref": "#/components/schemas/VoteKind"
          },
          "chamber": {
            "$ref": "#/components/schemas/Chamber"
          },
          "congress": {
            "type": "integer"
          },
          "session": {
            "type": "integer"
          },
          "rollNumber": {
            "type": "integer",
            "nullable": true
          },
          "question": {
            "type": "string"
          },
          "billId": {
            "type": "string",
            "nullable": true
          },
          "nominationId": {
            "type": "string",
            "nullable": true,
            "example": "119-pn-1093-3"
          },
          "billRef": {
            "type": "string",
            "nullable": true,
            "example": "H CON RES 14"
          },
          "occurredAt": {
            "type": "string",
            "nullable": true,
            "example": "2025-04-10T15:08:00.000Z"
          },
          "state": {
            "$ref": "#/components/schemas/VoteState"
          },
          "threshold": {
            "$ref": "#/components/schemas/VoteThreshold"
          },
          "totals": {
            "$ref": "#/components/schemas/VoteTotals"
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "result": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "kind",
          "chamber",
          "congress",
          "session",
          "rollNumber",
          "question",
          "billId",
          "nominationId",
          "billRef",
          "occurredAt",
          "state",
          "threshold",
          "totals",
          "candidates",
          "result"
        ]
      },
      "MemberVote": {
        "type": "object",
        "properties": {
          "vote": {
            "$ref": "#/components/schemas/Vote"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "choice": {
            "type": "string",
            "nullable": true,
            "description": "Candidate named in a Speaker election"
          },
          "measure": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MeasureSummary"
              },
              {
                "description": "null for a procedural vote that refers to no measure, e.g. a motion to adjourn"
              }
            ]
          }
        },
        "required": [
          "vote",
          "position",
          "choice",
          "measure"
        ]
      },
      "LatestAction": {
        "type": "object",
        "nullable": true,
        "properties": {
          "on": {
            "type": "string",
            "example": "2025-05-20"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "on",
          "text"
        ]
      },
      "CboEstimate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pubDate": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "pubDate"
        ]
      },
      "BillAction": {
        "type": "object",
        "properties": {
          "actedOn": {
            "type": "string",
            "example": "2025-05-20"
          },
          "chamber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Chamber"
              },
              {
                "nullable": true
              }
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "actedOn",
          "chamber",
          "text"
        ]
      },
      "Bill": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "119-hconres-14"
          },
          "congress": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "example": "hconres"
          },
          "number": {
            "type": "integer"
          },
          "citation": {
            "type": "string",
            "description": "As the chamber cites it",
            "example": "H.Con.Res. 14"
          },
          "title": {
            "type": "string"
          },
          "shortTitle": {
            "type": "string",
            "nullable": true
          },
          "sponsor": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Member"
              },
              {
                "nullable": true
              }
            ]
          },
          "introducedOn": {
            "type": "string",
            "nullable": true
          },
          "originChamber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Chamber"
              },
              {
                "nullable": true
              }
            ]
          },
          "policyArea": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true,
            "description": "Latest Congressional Research Service summary, plain text"
          },
          "summaryStage": {
            "type": "string",
            "nullable": true
          },
          "latestAction": {
            "$ref": "#/components/schemas/LatestAction"
          },
          "cboEstimates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CboEstimate"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BillAction"
            }
          },
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vote"
            }
          }
        },
        "required": [
          "id",
          "congress",
          "type",
          "number",
          "citation",
          "title",
          "shortTitle",
          "sponsor",
          "introducedOn",
          "originChamber",
          "policyArea",
          "summary",
          "summaryStage",
          "latestAction",
          "cboEstimates",
          "actions",
          "votes"
        ]
      },
      "AnalysisSource": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "crs_summary"
            ]
          },
          "stage": {
            "type": "string",
            "description": "The CRS summary version analysed",
            "example": "Public Law"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The summary as analysed; citations index into this"
          },
          "stale": {
            "type": "boolean",
            "description": "The bill's summary has changed since; a new analysis is pending. Citations still resolve against paragraphs."
          }
        },
        "required": [
          "kind",
          "stage",
          "paragraphs",
          "stale"
        ]
      },
      "AnalysisCitation": {
        "type": "object",
        "properties": {
          "paragraph": {
            "type": "integer",
            "description": "1-based index into source.paragraphs",
            "example": 3
          },
          "quote": {
            "type": "string",
            "description": "Verbatim excerpt of that paragraph",
            "example": "extends several expiring programs and authorities"
          },
          "section": {
            "type": "string",
            "nullable": true,
            "description": "The bill section, as CRS labels the paragraph; null when it names none",
            "example": "Sec. 101"
          }
        },
        "required": [
          "paragraph",
          "quote",
          "section"
        ]
      },
      "AnalysisClaim": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "ai": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Always true: this line was written by AI"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisCitation"
            },
            "description": "At least one"
          }
        },
        "required": [
          "text",
          "ai",
          "citations"
        ]
      },
      "BillAnalysis": {
        "type": "object",
        "properties": {
          "billId": {
            "type": "string",
            "example": "118-hr-6363"
          },
          "ai": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "label": {
            "type": "string",
            "enum": [
              "AI-generated"
            ]
          },
          "disclaimer": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/AnalysisSource"
          },
          "model": {
            "type": "string",
            "example": "claude-sonnet-5-5"
          },
          "verifierModel": {
            "type": "string",
            "nullable": true
          },
          "promptVersion": {
            "type": "string",
            "example": "bill-analysis/1"
          },
          "generatedAt": {
            "type": "string"
          },
          "provisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisClaim"
            }
          },
          "affectedGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisClaim"
            }
          },
          "impact": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisClaim"
            }
          },
          "purpose": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AnalysisClaim"
              },
              {
                "nullable": true,
                "description": "null when no purpose line survived verification"
              }
            ]
          }
        },
        "required": [
          "billId",
          "ai",
          "label",
          "disclaimer",
          "source",
          "model",
          "verifierModel",
          "promptVersion",
          "generatedAt",
          "provisions",
          "affectedGroups",
          "impact",
          "purpose"
        ]
      },
      "Nomination": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "119-pn-1093-3"
          },
          "congress": {
            "type": "integer"
          },
          "number": {
            "type": "integer"
          },
          "part": {
            "type": "integer",
            "description": "0 unless the Senate split the nomination into parts"
          },
          "citation": {
            "type": "string",
            "description": "As the Senate cites it on the roll call",
            "example": "PN1093-3"
          },
          "nomineeName": {
            "type": "string",
            "nullable": true,
            "description": "null for military nominations, which promote officers in bulk; show the position instead"
          },
          "positionTitle": {
            "type": "string",
            "nullable": true,
            "example": "United States District Judge for the Southern District of Ohio"
          },
          "organization": {
            "type": "string",
            "nullable": true,
            "example": "The Judiciary"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Congress.gov's full sentence, including the \"vice ...\" clause"
          },
          "nomineeCount": {
            "type": "integer",
            "nullable": true
          },
          "isMilitary": {
            "type": "boolean"
          },
          "receivedOn": {
            "type": "string",
            "nullable": true
          },
          "latestAction": {
            "$ref": "#/components/schemas/LatestAction"
          },
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vote"
            }
          }
        },
        "required": [
          "id",
          "congress",
          "number",
          "part",
          "citation",
          "nomineeName",
          "positionTitle",
          "organization",
          "description",
          "nomineeCount",
          "isMilitary",
          "receivedOn",
          "latestAction",
          "votes"
        ]
      },
      "ChamberStatus": {
        "type": "object",
        "properties": {
          "chamber": {
            "$ref": "#/components/schemas/Chamber"
          },
          "inSession": {
            "type": "boolean",
            "description": "Sitting now, or within 15 minutes of convening"
          },
          "convenesAt": {
            "type": "string",
            "nullable": true,
            "description": "Next (or current) convening, when the chamber has published it"
          },
          "legislativeDay": {
            "type": "string",
            "nullable": true,
            "example": "2026-11-10"
          },
          "checkedAt": {
            "type": "string",
            "description": "When the live worker last polled this chamber"
          }
        },
        "required": [
          "chamber",
          "inSession",
          "convenesAt",
          "legislativeDay",
          "checkedAt"
        ]
      },
      "LiveVote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "house-119-1-100"
          },
          "kind": {
            "$ref": "#/components/schemas/VoteKind"
          },
          "chamber": {
            "$ref": "#/components/schemas/Chamber"
          },
          "congress": {
            "type": "integer"
          },
          "session": {
            "type": "integer"
          },
          "rollNumber": {
            "type": "integer",
            "nullable": true
          },
          "question": {
            "type": "string"
          },
          "billId": {
            "type": "string",
            "nullable": true
          },
          "nominationId": {
            "type": "string",
            "nullable": true,
            "example": "119-pn-1093-3"
          },
          "billRef": {
            "type": "string",
            "nullable": true,
            "example": "H CON RES 14"
          },
          "occurredAt": {
            "type": "string",
            "nullable": true,
            "example": "2025-04-10T15:08:00.000Z"
          },
          "state": {
            "$ref": "#/components/schemas/VoteState"
          },
          "threshold": {
            "$ref": "#/components/schemas/VoteThreshold"
          },
          "totals": {
            "$ref": "#/components/schemas/VoteTotals"
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "result": {
            "type": "string",
            "nullable": true
          },
          "openedAt": {
            "type": "string",
            "nullable": true,
            "description": "The floor's own time for the vote (House only)"
          },
          "announcedAt": {
            "type": "string",
            "nullable": true,
            "description": "When the worker first saw a floor source name it"
          },
          "postedAt": {
            "type": "string",
            "nullable": true,
            "description": "When the worker first saw the roll call XML, polling live; null if it was backfilled"
          }
        },
        "required": [
          "id",
          "kind",
          "chamber",
          "congress",
          "session",
          "rollNumber",
          "question",
          "billId",
          "nominationId",
          "billRef",
          "occurredAt",
          "state",
          "threshold",
          "totals",
          "candidates",
          "result",
          "openedAt",
          "announcedAt",
          "postedAt"
        ]
      },
      "Live": {
        "type": "object",
        "properties": {
          "chambers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChamberStatus"
            },
            "description": "Empty until the live worker has run"
          },
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LiveVote"
            },
            "description": "Open votes named in the last 24 hours, then votes that went final within `since`; newest first"
          }
        },
        "required": [
          "chambers",
          "votes"
        ]
      },
      "SourceStatus": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "example": "house_rollcalls"
          },
          "lastSuccessAt": {
            "type": "string",
            "nullable": true
          },
          "lastNewDataAt": {
            "type": "string",
            "nullable": true,
            "description": "When a successful run last stored anything. A scheduled job keeps lastSuccessAt fresh even when upstream stops publishing or nothing is found, so a long gap here, not `stale`, is what shows that"
          },
          "lastError": {
            "type": "string",
            "nullable": true,
            "description": "The error of the latest run with an outcome, if it failed; null once a later run succeeds. A run that never recorded an outcome within an hour reads as \"abandoned run\""
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "lastSuccessAt",
          "lastNewDataAt",
          "lastError",
          "stale"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/votes/{id}": {
      "get": {
        "summary": "Get a vote with its totals, party breakdown and named members' positions",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^(house|senate)-\\d+-\\d-\\d+$",
              "example": "house-119-1-100"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]\\d{6}(,[A-Z]\\d{6})*$",
              "description": "Return these members' own positions on the vote — your delegation, for the vote screen.",
              "example": "D000399,C001098"
            },
            "required": false,
            "name": "members",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The vote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoteDetail"
                }
              }
            }
          },
          "404": {
            "description": "No vote with that ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/{id}": {
      "get": {
        "summary": "A member and how often they vote with their own party",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]\\d{6}$",
              "example": "A000370"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberDetail"
                }
              }
            }
          },
          "404": {
            "description": "No member with that ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/{id}/funding": {
      "get": {
        "summary": "Who funds a member's current campaign",
        "description": "Totals the campaign reported receiving, and the committees that reported giving to it. The two come from different FEC sources and will not reconcile. No individual donor is named: FEC publishes them, Floor does not store them.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]\\d{6}$",
              "example": "A000370"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "maximum": 50,
              "default": 10,
              "description": "How many giving committees to return"
            },
            "required": false,
            "name": "committees",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The member and their campaign's money",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberFunding"
                }
              }
            }
          },
          "404": {
            "description": "No member with that ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reps": {
      "get": {
        "summary": "Find your district and members of Congress from an address or your location",
        "description": "Send either `address`, or `lat` and `lng` (for example from the browser's location). Coordinates are rounded to 4 decimal places (about 11 m). Either is sent to the U.S. Census geocoder and is not stored or logged.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 5,
              "maxLength": 200,
              "example": "1100 Congress Ave, Austin, TX 78701"
            },
            "required": false,
            "name": "address",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "minimum": -90,
              "maximum": 90,
              "example": 30.2747
            },
            "required": false,
            "name": "lat",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "nullable": true,
              "minimum": -180,
              "maximum": 180,
              "example": -97.7404
            },
            "required": false,
            "name": "lng",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Your district and members",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reps"
                }
              }
            }
          },
          "400": {
            "description": "Neither or both of an address and coordinates, or values out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Place not in a U.S. congressional district",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/{id}/votes": {
      "get": {
        "summary": "A member's most recent votes and how they voted",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]\\d{6}$",
              "example": "A000370"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Votes, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "votes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MemberVote"
                      }
                    }
                  },
                  "required": [
                    "votes"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/bills/{id}": {
      "get": {
        "summary": "A bill with its summary, sponsor, recent actions and every vote on it",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{2,3}-(hr|hres|hjres|hconres|s|sres|sjres|sconres)-\\d+$",
              "example": "119-hconres-14"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The bill",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bill"
                }
              }
            }
          },
          "404": {
            "description": "No bill with that ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bills/{id}/analysis": {
      "get": {
        "summary": "AI analysis of a bill's CRS summary: purpose, provisions, affected groups and impact, each line cited",
        "description": "Every line is AI-written (`ai: true`) and cites the summary paragraph it came from, quoted verbatim. Lines whose citation didn't check out, or that a second AI pass found unsupported, have been removed. Show `disclaimer` with it.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{2,3}-(hr|hres|hjres|hconres|s|sres|sjres|sconres)-\\d+$",
              "example": "118-hr-6363"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The analysis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillAnalysis"
                }
              }
            }
          },
          "404": {
            "description": "No analysis for that bill yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/nominations/{id}": {
      "get": {
        "summary": "A presidential nomination with every Senate vote on it",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{2,3}-pn-\\d+(-\\d+)?$",
              "example": "119-pn-1093-3"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The nomination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Nomination"
                }
              }
            }
          },
          "404": {
            "description": "No nomination with that ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live": {
      "get": {
        "summary": "What is happening on the floor: each chamber's session state and the votes open or just final",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 120,
              "description": "Include votes that went final within this many minutes",
              "example": 120
            },
            "required": false,
            "name": "since",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Cached at the edge for 5 seconds (public, max-age=5, s-maxage=5, stale-while-revalidate=5)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Data freshness for each ingest source",
        "responses": {
          "200": {
            "description": "ok is false when any source is stale",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceStatus"
                      }
                    }
                  },
                  "required": [
                    "ok",
                    "sources"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
